# =========================================================
# Phase 2 reports — preserve previous default policy
# =========================================================

/reports/phase2/*

!/reports/phase2/*_acceptance_v1.json
!/reports/phase2/*_freeze_v1.json
!/reports/phase2/environment_baseline_v1.json


# =========================================================
# NB22 quality experiments — summaries only
#
# Reopen parent directories, then allow named summary reports.
# Per-query orders, case packs, diagnostics and other large
# experiment payloads remain local.
# =========================================================

!/reports/phase2/quality_improvement/
/reports/phase2/quality_improvement/*

!/reports/phase2/quality_improvement/NB22E.lab.v*/
/reports/phase2/quality_improvement/NB22E.lab.v*/*

!/reports/phase2/quality_improvement/NB22E.lab.v*/README.md
!/reports/phase2/quality_improvement/NB22E.lab.v*/C010.expand60_report.*.json
!/reports/phase2/quality_improvement/NB22E.lab.v*/C011.offline_report.*.json
!/reports/phase2/quality_improvement/NB22E.lab.v*/C012.token_window_report.*.json
!/reports/phase2/quality_improvement/NB22E.lab.v*/C013.contrast_report.*.json
!/reports/phase2/quality_improvement/NB22E.lab.v*/C014.local_model_inventory.*.json
!/reports/phase2/quality_improvement/NB22E.lab.v*/C015.pinned_model_asset.*.json
!/reports/phase2/quality_improvement/NB22E.lab.v*/C016.bge_cpu_pilot.*.json
