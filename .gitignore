# ==========================================
# Generated Golden Dataset experiments — NB12g
# ==========================================

# API caches and temporary judge output
notebooks/phase2/golden_dataset/cache/
notebooks/phase2/golden_dataset/**/cache/
notebooks/phase2/golden_dataset/**/batches/

# Temporary candidate and experiment datasets
notebooks/phase2/golden_dataset/*_candidate.jsonl
notebooks/phase2/golden_dataset/*_review_queue.jsonl
notebooks/phase2/golden_dataset/*_experiment.jsonl
notebooks/phase2/golden_dataset/*_experiment_*.json
notebooks/phase2/golden_dataset/*_experiment_*.jsonl

# Generated integrity, semantic-judge and repair reports
notebooks/phase2/golden_dataset/*_integrity_audit.json
notebooks/phase2/golden_dataset/*_semantic_judge.json
notebooks/phase2/golden_dataset/*_findings_packet.json
notebooks/phase2/golden_dataset/*_repair_report.json
notebooks/phase2/golden_dataset/*_adjudication_report.json
notebooks/phase2/golden_dataset/*_evidence_span_repair.json

# Do not ignore approved Golden Dataset versions.
# Examples:
# - golden_dataset_v1.jsonl
# - golden_dataset_v2.jsonl
# - golden_dataset_v2_acceptance_v1.json

