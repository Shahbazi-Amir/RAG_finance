# =========================================================
# RAG_finance — .gitignore v2
#
# Track:
#   source code, notebooks, documentation, dependency locks,
#   formal manifests, approved Golden datasets, summary reports.
#
# Ignore:
#   local environments, secrets, model weights, generated data,
#   runtime caches, pair scores, large experimental payloads.
#
# Ignore rules do not remove files already tracked by Git.
# =========================================================


# =========================================================
# Python / build / testing
# =========================================================

__pycache__/
*.py[cod]
*$py.class
*.so

*.egg
*.egg-info/
.eggs/

build/
dist/
sdist/
wheels/

.coverage
.coverage.*
coverage.xml
htmlcov/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/
.hypothesis/
.cache/


# =========================================================
# Virtual environments
# =========================================================

rag_env/
venv/
.venv/
env/
ENV/
.conda/


# =========================================================
# Secrets / credentials
# =========================================================

.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

.envrc
.netrc
.pypirc

*.pem
*.key
*.p12
*.pfx

secrets/
credentials/

# Do not broadly ignore *.lock:
# dependency lockfiles must remain trackable.


# =========================================================
# Jupyter / IDE / operating system
# =========================================================

.ipynb_checkpoints/
.jupyter/

.vscode/
.idea/

.DS_Store
.AppleDouble/
.LSOverride
._*
Thumbs.db
desktop.ini

*.swp
*.swo
*~
~$*

# Keep .ipynb notebooks trackable.


# =========================================================
# Logs / temporary files / runtime locks
# =========================================================

*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid
*.pid.lock

*.incomplete
*.part
*.partial

# Hugging Face download locks, not dependency locks
**/.locks/


# =========================================================
# Local databases / journals
# =========================================================

*.db
*.db-journal
*.db-wal
*.db-shm

*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm


# =========================================================
# Phase 1 — generated data
# =========================================================

/data/processed/
/data/chunks/
/data/embeddings/
/data/vectorstore/
/data/index/
/data/database/


