# =========================================================

/tmp/
/temp/
/scratch/
/exports/
/local_exports/
/downloads/

# =========================================================
# v3 — Local checkpoints / experimental artifacts
# =========================================================

/artifacts/phase2/checkpoints/
/artifacts/phase2/quality_improvement/
/notebooks/phase2/backup_versions/

# =========================================================
# Preserve formal evaluation documents and JSON reports.
# Large non-document payloads remain ignored by default.
# =========================================================

!/reports/phase2/evaluation/
/reports/phase2/evaluation/**/*
!/reports/phase2/evaluation/**/
!/reports/phase2/evaluation/**/*.md
!/reports/phase2/evaluation/**/*.json

# =========================================================
# Preserve retrieval manifests / evidence / validation.
# Generated candidate JSONL files remain ignored.
# =========================================================

!/data/phase2/retrieval/
/data/phase2/retrieval/*
!/data/phase2/retrieval/hybrid_retrieval_v1/
!/data/phase2/retrieval/reranker_v1/

/data/phase2/retrieval/hybrid_retrieval_v1/*
/data/phase2/retrieval/reranker_v1/*

!/data/phase2/retrieval/hybrid_retrieval_v1/*.json
!/data/phase2/retrieval/reranker_v1/*.json

# Keep OS metadata ignored, including in reopened directories.
.DS_Store
._*


# =========================================================
# v4 — Narrow NB21 evaluation JSON exceptions
# Overrides the earlier broad JSON allow rule.
# =========================================================

/reports/phase2/evaluation/**/*.json

# Documentation-package metadata
!/reports/phase2/evaluation/NB21_actions01_49_reports/action_reports_manifest.json
!/reports/phase2/evaluation/NB21_actions01_49_reports/package_file_hashes.json
!/reports/phase2/evaluation/NB21_actions01_49_reports/source_manifest.json

# Final consolidated NB21 summary
!/reports/phase2/evaluation/NB21C.C085.action49_final_summary/*summary*.json