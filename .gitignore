/data/phase2/raw/
/data/phase2/interim/
/data/phase2/processed/
/data/phase2/chunks/
/data/phase2/embeddings/
/data/phase2/vectorstore/
/data/phase2/index/
/data/phase2/database/
/data/phase2/retrieval/
/data/phase2/chatgpt_recovery_20261003/

# Intentionally trackable:
# /data/phase2/manifests/


# =========================================================
# Generated artifact caches / runtime work
# =========================================================

/artifacts/**/cache/
/artifacts/**/caches/
/artifacts/**/batches/
/artifacts/**/work/

/artifacts/**/*_cache/
/artifacts/**/*_cache_v*/
/artifacts/**/*_caches/
/artifacts/**/*_batches/

# Explicit NB22 caches; preserve locally for resuming runs.
/artifacts/phase2/quality_improvement/NB22E.pair_cache_v1/
/artifacts/phase2/quality_improvement/NB22E.bge_top20_cache_v1/

# Generated binary / columnar payloads
/artifacts/**/*.pkl
/artifacts/**/*.pickle
/artifacts/**/*.parquet
/artifacts/**/*.arrow
/artifacts/**/*.index


