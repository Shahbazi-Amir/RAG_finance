# Do not ignore approved Golden Dataset versions:
# golden_dataset_v1.jsonl, golden_dataset_v2.jsonl, etc.

notebooks/phase2/golden_dataset/*_experiment.jsonl
notebooks/phase2/golden_dataset/*_experiment_*.json
notebooks/phase2/golden_dataset/*_experiment_*.jsonl
notebooks/phase2/golden_dataset/*_candidate.jsonl
notebooks/phase2/golden_dataset/*_review_queue.jsonl

# Large transient caches inside otherwise tracked artifact folders
artifacts/phase2/**/cache/
artifacts/phase2/**/batches/
artifacts/phase2/**/*.npz

